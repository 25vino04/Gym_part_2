<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Blog - High Street Gym</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/blog.css">
</head>

<body>
    <header>
        <%- include('partials/nav') %>
    </header>

    <main class="blog-page">
        <div class="blog-header">
            <h1>Member Blog</h1>
            <p>Share your fitness journey and connect with our community</p>
        </div>


        <% if (locals.user && ['member', 'trainer' , 'admin' ].includes(user.role)) { %>
            <section class="create-post-section">
                <h2>Create New Post</h2>

                <% if (locals.error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (locals.success) { %>
                            <div class="success-message">
                                <%= success %>
                            </div>
                            <% } %>

                                <form method="POST" action="/blog/create" class="create-post-form">
                                    <div class="form-group">
                                        <label for="title">Title</label>
                                        <input type="text" id="title" name="title" required
                                            placeholder="Give your post a title" maxlength="200">
                                    </div>

                                    <div class="form-group">
                                        <label for="content">Content</label>
                                        <textarea id="content" name="content" required rows="6"
                                            placeholder="Share your thoughts, progress, or tips..."></textarea>
                                    </div>

                                    <button type="submit" class="btn-post">Publish Post</button>
                                </form>
            </section>
            <% } %>

                <% if (!locals.user) { %>
                    <div class="guest-info">
                        <p>You're viewing posts as a guest. <a href="/register">Join us</a> to share your own stories!
                        </p>
                    </div>
                    <% } %>

                        <section class="posts-feed">
                            <h2>Recent Posts</h2>

                            <% if (posts && posts.length> 0) { %>
                                <% posts.forEach(post=> { %>
                                    <article class="post-card">
                                        <div class="post-header">
                                            <div class="post-author">
                                                <div class="author-avatar">

                                                    <%= post.author_name ? post.author_name.substring(0,
                                                        2).toUpperCase() : '??' %>
                                                </div>
                                                <div class="author-info">
                                                    <span class="author-name">

                                                        <%= post.author_name || 'Unknown User' %>
                                                    </span>
                                                    <span class="post-date">
                                                        <%= new Date(post.created_at).toLocaleDateString('en-AU', {
                                                            year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                                    </span>
                                                </div>
                                            </div>
                                            <% if (locals.user && (user.id===post.user_id || user.role==='admin' )) { %>
                                                <form method="POST" action="/blog/<%= post.id %>/delete"
                                                    class="delete-form">
                                                    <button type="submit" class="btn-delete"
                                                        onclick="return confirm('Are you sure you want to delete this post?')">
                                                        Delete
                                                    </button>
                                                </form>
                                                <% } %>
                                        </div>

                                        <div class="post-body">
                                            <h3>
                                                <%= post.title %>
                                            </h3>
                                            <p>
                                                <%= post.content %>
                                            </p>
                                        </div>

                                        <% if (post.status==='draft' ) { %>
                                            <span class="post-status draft">Draft</span>
                                            <% } %>
                                    </article>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="no-posts">
                                                <p>No posts yet. Be the first to share your story!</p>
                                            </div>
                                            <% } %>
                        </section>
    </main>

    <footer>
        <%- include('partials/footer') %>
    </footer>
</body>

</html>